<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://www.esprit.tn/ontologies/eduonto"
         xmlns="http://www.esprit.tn/ontologies/eduonto#">

<owl:Ontology rdf:about="http://www.esprit.tn/ontologies/eduonto"/>

<owl:ObjectProperty rdf:about="#aPourPrerequis">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
  <rdfs:domain rdf:resource="#Cours"/>
  <rdfs:range rdf:resource="#Cours"/>
  <owl:inverseOf rdf:resource="#estPrerequisDe"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#estPrerequisDe">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
  <rdfs:domain rdf:resource="#Cours"/>
  <rdfs:range rdf:resource="#Cours"/>
  <owl:inverseOf rdf:resource="#aPourPrerequis"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#enseigne">
  <rdfs:domain rdf:resource="#Enseignant"/>
  <rdfs:range rdf:resource="#Cours"/>
  <owl:inverseOf rdf:resource="#estEnseignePar"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#estEnseignePar">
  <rdfs:domain rdf:resource="#Cours"/>
  <rdfs:range rdf:resource="#Enseignant"/>
  <owl:inverseOf rdf:resource="#enseigne"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#contientCours">
  <rdfs:domain rdf:resource="#Formation"/>
  <rdfs:range rdf:resource="#Cours"/>
  <owl:inverseOf rdf:resource="#faitPartieDe"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#faitPartieDe">
  <rdfs:domain rdf:resource="#Cours"/>
  <rdfs:range rdf:resource="#Formation"/>
  <owl:inverseOf rdf:resource="#contientCours"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#encadre">
  <rdfs:domain rdf:resource="#Enseignant"/>
  <rdfs:range rdf:resource="#Etudiant"/>
  <owl:inverseOf rdf:resource="#estEncadrePar"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#estEncadrePar">
  <rdfs:domain rdf:resource="#Etudiant"/>
  <rdfs:range rdf:resource="#Enseignant"/>
  <owl:inverseOf rdf:resource="#encadre"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#estResponsableDe">
  <rdfs:domain rdf:resource="#Personne"/>
  <rdfs:range rdf:resource="#Formation"/>
  <owl:inverseOf rdf:resource="#aPourResponsable"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#aPourResponsable">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Formation"/>
  <rdfs:range rdf:resource="#Personne"/>
  <owl:inverseOf rdf:resource="#estResponsableDe"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#estComplementaireDe">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
  <rdfs:domain rdf:resource="#Cours"/>
  <rdfs:range rdf:resource="#Cours"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#developpeCompetence">
  <rdfs:domain rdf:resource="#Cours"/>
  <rdfs:range rdf:resource="#Competence"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#necessiteCompetence">
  <rdfs:domain rdf:resource="#Cours"/>
  <rdfs:range rdf:resource="#Competence"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#possedeCompetence">
  <rdfs:domain rdf:resource="#Etudiant"/>
  <rdfs:range rdf:resource="#Competence"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#inscritA">
  <rdfs:domain rdf:resource="#Etudiant"/>
  <rdfs:range rdf:resource="#Formation"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#aValide">
  <rdfs:domain rdf:resource="#Etudiant"/>
  <rdfs:range rdf:resource="#Cours"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#aPasse">
  <rdfs:domain rdf:resource="#Etudiant"/>
  <rdfs:range rdf:resource="#Evaluation"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#suitParcours">
  <rdfs:domain rdf:resource="#Etudiant"/>
  <rdfs:range rdf:resource="#ParcoursApprentissage"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#proposeParcours">
  <rdfs:domain rdf:resource="#Formation"/>
  <rdfs:range rdf:resource="#ParcoursApprentissage"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#comprendCours">
  <rdfs:domain rdf:resource="#ParcoursApprentissage"/>
  <rdfs:range rdf:resource="#Cours"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#estEvaluePar">
  <rdfs:domain rdf:resource="#Cours"/>
  <rdfs:range rdf:resource="#Evaluation"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#utiliseRessource">
  <rdfs:domain rdf:resource="#Cours"/>
  <rdfs:range rdf:resource="#RessourcePedagogique"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#appartientADomaine">
  <rdfs:domain rdf:resource="#Cours"/>
  <rdfs:range rdf:resource="#Domaine"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#concerne">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#IndicateurApprentissage"/>
  <rdfs:range rdf:resource="#Etudiant"/>
  <owl:inverseOf rdf:resource="#aIndicateur"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#aIndicateur">
  <rdfs:domain rdf:resource="#Etudiant"/>
  <rdfs:range rdf:resource="#IndicateurApprentissage"/>
  <owl:inverseOf rdf:resource="#concerne"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#assiste">
  <rdfs:domain rdf:resource="#AgentPedagogiqueIA"/>
  <rdfs:range rdf:resource="#Etudiant"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#recommande">
  <rdfs:domain rdf:resource="#AgentPedagogiqueIA"/>
  <rdfs:range>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Cours"/>
        <rdf:Description rdf:about="#RessourcePedagogique"/>
        <rdf:Description rdf:about="#ParcoursApprentissage"/>
      </owl:unionOf>
    </owl:Class>
  </rdfs:range>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#corrige">
  <rdfs:domain rdf:resource="#CorrecteurAutomatique"/>
  <rdfs:range rdf:resource="#Evaluation"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#atteste">
  <rdfs:domain rdf:resource="#PreuveDeCompetence"/>
  <rdfs:range rdf:resource="#Competence"/>
  <owl:inverseOf rdf:resource="#estAttesteePar"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#estAttesteePar">
  <rdfs:domain rdf:resource="#Competence"/>
  <rdfs:range rdf:resource="#PreuveDeCompetence"/>
  <owl:inverseOf rdf:resource="#atteste"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#delivreA">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#PreuveDeCompetence"/>
  <rdfs:range rdf:resource="#Etudiant"/>
  <owl:inverseOf rdf:resource="#obtientPreuve"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#obtientPreuve">
  <rdfs:domain rdf:resource="#Etudiant"/>
  <rdfs:range rdf:resource="#PreuveDeCompetence"/>
  <owl:inverseOf rdf:resource="#delivreA"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#requiertCompetence">
  <rdfs:domain rdf:resource="#Metier"/>
  <rdfs:range rdf:resource="#Competence"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#viseMetier">
  <rdfs:domain rdf:resource="#Etudiant"/>
  <rdfs:range rdf:resource="#Metier"/>
</owl:ObjectProperty>

<owl:DatatypeProperty rdf:about="#nom">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Personne"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#email">
  <rdfs:domain rdf:resource="#Personne"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#anneeEtude">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Etudiant"/>
  <rdfs:range>
    <rdfs:Datatype>
      <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
      <owl:withRestrictions>
        <rdf:Description>
          <rdf:first>
            <rdf:Description>
              <xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</xsd:maxInclusive>
            </rdf:Description>
          </rdf:first>
          <rdf:rest>
            <rdf:Description>
              <rdf:first>
                <rdf:Description>
                  <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</xsd:minInclusive>
                </rdf:Description>
              </rdf:first>
              <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </rdf:Description>
          </rdf:rest>
        </rdf:Description>
      </owl:withRestrictions>
    </rdfs:Datatype>
  </rdfs:range>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#codeCours">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Cours"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#intitule">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Cours"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#nbCredits">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Cours"/>
  <rdfs:range>
    <rdfs:Datatype>
      <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
      <owl:withRestrictions>
        <rdf:Description>
          <rdf:first>
            <rdf:Description>
              <xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10</xsd:maxInclusive>
            </rdf:Description>
          </rdf:first>
          <rdf:rest>
            <rdf:Description>
              <rdf:first>
                <rdf:Description>
                  <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</xsd:minInclusive>
                </rdf:Description>
              </rdf:first>
              <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </rdf:Description>
          </rdf:rest>
        </rdf:Description>
      </owl:withRestrictions>
    </rdfs:Datatype>
  </rdfs:range>
  <rdfs:subPropertyOf rdf:resource="#intitule"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#volumeHoraire">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Cours"/>
  <rdfs:range>
    <rdfs:Datatype>
      <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
      <owl:withRestrictions>
        <rdf:Description>
          <rdf:first>
            <rdf:Description>
              <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</xsd:minInclusive>
            </rdf:Description>
          </rdf:first>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
      </owl:withRestrictions>
    </rdfs:Datatype>
  </rdfs:range>
  <rdfs:subPropertyOf rdf:resource="#intitule"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#niveau">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Cours"/>
  <rdfs:range>
    <rdfs:Datatype>
      <owl:oneOf>
        <rdf:Description>
      <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Débutant</rdf:first>
        <rdf:rest>
        <rdf:Description>
      <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Intermédiaire</rdf:first>
        <rdf:rest>
        <rdf:Description>
      <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Avancé</rdf:first>
        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
        </rdf:rest>
        </rdf:Description>
        </rdf:rest>
        </rdf:Description>
      </owl:oneOf>
    </rdfs:Datatype>
  </rdfs:range>
  <rdfs:subPropertyOf rdf:resource="#codeCours"/>
  <rdfs:subPropertyOf rdf:resource="#modalite"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#note">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Evaluation"/>
  <rdfs:range>
    <rdfs:Datatype>
      <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
      <owl:withRestrictions>
        <rdf:Description>
          <rdf:first>
            <rdf:Description>
              <xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">20.0</xsd:maxInclusive>
            </rdf:Description>
          </rdf:first>
          <rdf:rest>
            <rdf:Description>
              <rdf:first>
                <rdf:Description>
                  <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.0</xsd:minInclusive>
                </rdf:Description>
              </rdf:first>
              <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </rdf:Description>
          </rdf:rest>
        </rdf:Description>
      </owl:withRestrictions>
    </rdfs:Datatype>
  </rdfs:range>
  <rdfs:subPropertyOf rdf:resource="#coefficient"/>
  <rdfs:subPropertyOf rdf:resource="#codeEvaluation"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#session">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Evaluation"/>
  <rdfs:range>
    <rdfs:Datatype>
      <owl:oneOf>
        <rdf:Description>
      <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Principale</rdf:first>
        <rdf:rest>
        <rdf:Description>
      <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Rattrapage</rdf:first>
        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
        </rdf:rest>
        </rdf:Description>
      </owl:oneOf>
    </rdfs:Datatype>
  </rdfs:range>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#matricule">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Etudiant"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#specialite">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Enseignant"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:subPropertyOf rdf:resource="#email"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#semestre">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Cours"/>
  <rdfs:range>
    <rdfs:Datatype>
      <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
      <owl:withRestrictions>
        <rdf:Description>
          <rdf:first>
            <rdf:Description>
              <xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10</xsd:maxInclusive>
            </rdf:Description>
          </rdf:first>
          <rdf:rest>
            <rdf:Description>
              <rdf:first>
                <rdf:Description>
                  <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</xsd:minInclusive>
                </rdf:Description>
              </rdf:first>
              <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </rdf:Description>
          </rdf:rest>
        </rdf:Description>
      </owl:withRestrictions>
    </rdfs:Datatype>
  </rdfs:range>
  <rdfs:subPropertyOf rdf:resource="#intitule"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#intituleFormation">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Formation"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:subPropertyOf rdf:resource="#modalite"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#dureeAnnees">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Formation"/>
  <rdfs:range>
    <rdfs:Datatype>
      <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
      <owl:withRestrictions>
        <rdf:Description>
          <rdf:first>
            <rdf:Description>
              <xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</xsd:maxInclusive>
            </rdf:Description>
          </rdf:first>
          <rdf:rest>
            <rdf:Description>
              <rdf:first>
                <rdf:Description>
                  <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</xsd:minInclusive>
                </rdf:Description>
              </rdf:first>
              <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </rdf:Description>
          </rdf:rest>
        </rdf:Description>
      </owl:withRestrictions>
    </rdfs:Datatype>
  </rdfs:range>
  <rdfs:subPropertyOf rdf:resource="#codeFormation"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#nbCreditsTotal">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Formation"/>
  <rdfs:range>
    <rdfs:Datatype>
      <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
      <owl:withRestrictions>
        <rdf:Description>
          <rdf:first>
            <rdf:Description>
              <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</xsd:minInclusive>
            </rdf:Description>
          </rdf:first>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
      </owl:withRestrictions>
    </rdfs:Datatype>
  </rdfs:range>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#libelleCompetence">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Competence"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#coefficient">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Evaluation"/>
  <rdfs:range>
    <rdfs:Datatype>
      <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
      <owl:withRestrictions>
        <rdf:Description>
          <rdf:first>
            <rdf:Description>
              <xsd:minExclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.0</xsd:minExclusive>
            </rdf:Description>
          </rdf:first>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
      </owl:withRestrictions>
    </rdfs:Datatype>
  </rdfs:range>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#dateEvaluation">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Evaluation"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#titre">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#RessourcePedagogique"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#url">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#RessourcePedagogique"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#dureeMinutes">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#RessourcePedagogique"/>
  <rdfs:range>
    <rdfs:Datatype>
      <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
      <owl:withRestrictions>
        <rdf:Description>
          <rdf:first>
            <rdf:Description>
              <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</xsd:minInclusive>
            </rdf:Description>
          </rdf:first>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
      </owl:withRestrictions>
    </rdfs:Datatype>
  </rdfs:range>
  <rdfs:subPropertyOf rdf:resource="#auteur"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#langue">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#RessourcePedagogique"/>
  <rdfs:range>
    <rdfs:Datatype>
      <owl:oneOf>
        <rdf:Description>
      <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FR</rdf:first>
        <rdf:rest>
        <rdf:Description>
